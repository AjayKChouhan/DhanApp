<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to ASP.NET Core abstractions (IDataProtectionProvider, IMemoryCache,
         IOptions, IHostEnvironment, ILogger) without pulling in classic standalone NuGet
         packages whose versions no longer track modern .NET releases. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Otp.NET" Version="1.4.1" />
  </ItemGroup>

</Project>
