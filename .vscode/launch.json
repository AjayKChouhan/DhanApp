{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/DhanAPI/bin/Debug/net10.0/DhanAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/DhanAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "^\\s*Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/docs"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch Angular",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "client-start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/DhanClient"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: API + Angular",
      "configurations": ["Launch API", "Launch Angular"]
    }
  ]
}